{
  "name": "cascata",
  "version": "0.1.0",
  "description": "A format-blind, positioned information model with a YAML adapter — the foundation of the Cascata configuration cascade.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "picomatch": "^4.0.7",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/picomatch": "^4.0.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
