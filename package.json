{
  "name": "@egildo/cascata",
  "version": "1.17.0",
  "description": "Schema-governed cascading configuration: a folder of human-readable documents turned into one validated, provenance-rich configuration object.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://codeberg.org/egildo/cascata.git"
  },
  "homepage": "https://codeberg.org/egildo/cascata",
  "bugs": "https://codeberg.org/egildo/cascata/issues",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./generate": {
      "types": "./dist/generate/index.d.ts",
      "import": "./dist/generate/index.js"
    },
    "./generate.js": {
      "types": "./dist/generate/index.d.ts",
      "import": "./dist/generate/index.js"
    },
    "./paths": {
      "types": "./dist/paths.d.ts",
      "import": "./dist/paths.js"
    },
    "./paths.js": {
      "types": "./dist/paths.d.ts",
      "import": "./dist/paths.js"
    },
    "./writers": {
      "types": "./dist/writers.d.ts",
      "import": "./dist/writers.js"
    },
    "./writers.js": {
      "types": "./dist/writers.d.ts",
      "import": "./dist/writers.js"
    },
    "./host/node": {
      "types": "./dist/host/node.d.ts",
      "import": "./dist/host/node.js"
    },
    "./host/node.js": {
      "types": "./dist/host/node.d.ts",
      "import": "./dist/host/node.js"
    },
    "./host/memory": {
      "types": "./dist/host/memory.d.ts",
      "import": "./dist/host/memory.js"
    },
    "./host/memory.js": {
      "types": "./dist/host/memory.d.ts",
      "import": "./dist/host/memory.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "meta"
  ],
  "scripts": {
    "test": "vitest run && vitest run --config vitest.timing.config.ts",
    "test:main": "vitest run",
    "test:timing": "vitest run --config vitest.timing.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "dist-tag": "sh scripts/dist-tag.sh"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@stenographers/stenography": "0.1.0",
    "@types/node": "^26.4.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
