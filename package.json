{
  "name": "cascata",
  "version": "1.8.0",
  "description": "Schema-governed cascading configuration: a folder of human-readable documents turned into one validated, provenance-rich configuration object.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./generate": {
      "types": "./dist/generate/index.d.ts",
      "import": "./dist/generate/index.js"
    },
    "./generate.js": {
      "types": "./dist/generate/index.d.ts",
      "import": "./dist/generate/index.js"
    },
    "./paths": {
      "types": "./dist/paths.d.ts",
      "import": "./dist/paths.js"
    },
    "./paths.js": {
      "types": "./dist/paths.d.ts",
      "import": "./dist/paths.js"
    },
    "./host/node": {
      "types": "./dist/host/node.d.ts",
      "import": "./dist/host/node.js"
    },
    "./host/node.js": {
      "types": "./dist/host/node.d.ts",
      "import": "./dist/host/node.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "meta"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "dist-tag": "sh scripts/dist-tag.sh"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
